# Base URL of the PandaSpot API. For local dev against a server running on
# your own machine, override this to http://localhost:4000 — the built-in
# fallback (used if this var is unset at build time) now points at the real
# production API, not localhost, so it's safe to leave unset in prod builds
# but you'll want it set explicitly here for local development.
VITE_API_URL=http://localhost:4000

# Google OAuth Client ID for "Sign in with Google". Leave empty to hide the
# Google Sign-In button entirely (it renders nothing until this is set).
VITE_GOOGLE_CLIENT_ID=
